{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@rx-trader/core": [
        "../../packages/core/src/index.ts"
      ],
      "@rx-trader/core/*": [
        "../../packages/core/src/*"
      ],
      "@rx-trader/backtest": [
        "../../packages/backtest/src/index.ts"
      ],
      "@rx-trader/backtest/*": [
        "../../packages/backtest/src/*"
      ],
      "@rx-trader/pipeline": [
        "../../packages/pipeline/src/index.ts"
      ],
      "@rx-trader/pipeline/*": [
        "../../packages/pipeline/src/*"
      ],
      "@rx-trader/observability": [
        "../../packages/observability/src/index.ts"
      ],
      "@rx-trader/observability/*": [
        "../../packages/observability/src/*"
      ],
      "@rx-trader/event-store": [
        "../../packages/event-store/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
